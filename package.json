{
  "name": "stepfolio", "version": "1.0.1", "private": true,
  "description": "บันทึกขั้นตอนบนหน้าจอและสร้างคู่มือ PDF", "author": "Stepfolio",
  "main": "src/main.js",
  "scripts": {"start": "electron .", "test": "node --test tests/*.test.js", "pack": "electron-builder --dir", "dist:mac": "electron-builder --mac --publish never", "dist:win": "electron-builder --win --x64 --publish never"},
  "dependencies": {"uiohook-napi": "^1.5.4"},
  "devDependencies": {"electron": "^41.0.0", "electron-builder": "^26.0.12", "@playwright/test": "^1.58.0"},
  "build": {
    "appId": "com.stepfolio.desktop", "productName": "Stepfolio",
    "directories": {"output": "release"}, "files": ["src/**/*", "package.json"],
    "asarUnpack": ["**/*.node"], "npmRebuild": false,
    "fileAssociations": [{"ext": "stepfolio", "name": "Stepfolio Project", "role": "Editor"}],
    "mac": {"icon": "assets/icon.icns", "target": ["dmg", "zip"], "category": "public.app-category.productivity", "extendInfo": {"NSScreenCaptureUsageDescription": "บันทึกภาพหน้าจอเพื่อสร้างคู่มือของคุณ", "NSInputMonitoringUsageDescription": "ตรวจจับตำแหน่งคลิกเพื่อบันทึกขั้นตอน"}},
    "win": {"icon": "assets/icon.ico", "target": ["nsis", "portable"]},
    "nsis": {"artifactName": "${productName}-Setup-${version}-${arch}.${ext}", "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true},
    "portable": {"artifactName": "${productName}-Portable-${version}-${arch}.${ext}"},
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
